# Copy to `.env` and adjust. Every variable is optional; see docs/ENV.md.

# If set, requests must send `Authorization: Bearer <PROXY_API_KEY>`.
PROXY_API_KEY=
# Requests per minute per client IP (0 = no limit).
RATE_LIMIT_PER_MINUTE=0

# Codex binary and working directory. Default workdir: /workspace (Linux/Docker),
# %LOCALAPPDATA%\codex-openai-bridge\workspace (Windows; use a drive letter if you set it).
CODEX_PATH=codex
# CODEX_WORKDIR=/workspace

# Concurrent Codex turns, and seconds per request.
CODEX_MAX_PARALLEL_REQUESTS=8
# Pre-started spare threads per system prompt (0 disables). Saves ~0.6-1 s per request;
# raise it to your typical burst size for concurrent requests with the same system prompt.
CODEX_IDLE_THREADS=2
CODEX_TIMEOUT=120

# Turn off plugins, MCP servers, hooks, tools and injected agent instructions.
CODEX_LEAN=true
# read-only | workspace-write | danger-full-access (only matters with CODEX_LEAN=false)
CODEX_SANDBOX_MODE=read-only

# Docker build: UID/GID of the container user (read by docker compose, ignored by the app).
HOST_UID=1000
HOST_GID=1000
